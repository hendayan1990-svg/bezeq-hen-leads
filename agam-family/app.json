{
  "expo": {
    "name": "AGAM Family",
    "slug": "agam-family",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "agamfamily",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agamfamily.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "AGAM Family uses the microphone only during clearly visible Safety Audio sessions."
      }
    },
    "android": {
      "package": "com.agamfamily.app",
      "adaptiveIcon": {
        "backgroundColor": "#F7FBFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow AGAM Family to show your location on the private family safety map.",
          "locationAlwaysAndWhenInUsePermission": "Allow AGAM Family to keep your family safety location updated in the background.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0A8CFF",
          "defaultChannel": "agam-safety"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F7FBFF"
        }
      ],
      "expo-router",
      "expo-secure-store",
      "expo-localization"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
